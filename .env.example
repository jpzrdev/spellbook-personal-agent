# Copie para .env e preencha. Nunca versione o .env.
# IA via Claude Code (assinatura Claude Pro). Faça login uma vez com: claude auth login
CLAUDE_BIN=
GANDALF_TIER2_MODEL=haiku
GANDALF_TIER3_MODEL=
GANDALF_TIER3_TIMEOUT_MIN=20
GANDALF_TIER3_MAX_SIMULTANEAS=2
GANDALF_LIMITE_DIARIO_CHAMADAS=40
# Horas que um resultado efêmero (ex.: resumo de e-mails) fica no HUD antes de ser apagado
GANDALF_EFEMERO_HORAS=48

# Voz offline: modelo do Whisper (small | medium) e voz do Kokoro.
# Uma voz (pm_santa, pm_alex, pf_dora) ou mistura "voz:peso+voz:peso". Padrão do Gandalf: pm_santa:0.5+bm_lewis:0.5
GANDALF_WHISPER_MODELO=medium
GANDALF_VOZ=
GANDALF_VOZ_VELOCIDADE=0.9

# Lembretes e notificações. Modelo da sessão que cria eventos no Google Agenda (só após você confirmar no HUD)
GANDALF_AGENDAR_MODELO=haiku
# Contato no token das notificações push (exigido pelos serviços de push; pode ficar o padrão)
PUSH_CONTATO=

# Caminho do vault (relativo à raiz do repo ou absoluto)
VAULT_PATH=vault

BRIDGE_HOST=127.0.0.1
BRIDGE_PORT=8787
# Token simples para o HUD. Gere um com:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
BRIDGE_TOKEN=
