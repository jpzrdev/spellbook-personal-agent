# Copy to .env and fill in. Never commit the .env.

# The assistant's language: what Gandalf says and the language of the notes it writes in the memory.
# The code and the HUD are always in English. Supported: en | pt-BR
GANDALF_LANGUAGE=en
# Your time zone (dates, routines and reminders)
TZ_NAME=America/Sao_Paulo

# AI through Claude Code (Claude subscription). Log in once with: claude auth login
CLAUDE_BIN=
GANDALF_TIER2_MODEL=haiku
GANDALF_TIER3_MODEL=
GANDALF_TIER3_TIMEOUT_MIN=20
GANDALF_TIER3_MAX_CONCURRENT=2
GANDALF_DAILY_CALL_LIMIT=40
# Hours an ephemeral result (e.g. an email summary) stays in the HUD before it's deleted
GANDALF_EPHEMERAL_HOURS=48

# Offline voice: the Whisper model (small | medium) and the Kokoro voice.
# One voice (bm_lewis, pm_santa, pf_dora…) or a mix "voice:weight+voice:weight".
# Default: bm_lewis in English; pm_santa:0.5+bm_lewis:0.5 in Portuguese.
GANDALF_WHISPER_MODEL=medium
GANDALF_VOICE=
GANDALF_VOICE_SPEED=0.9

# Reminders and notifications. The model of the session that creates Google Calendar events (only after you confirm in the HUD)
GANDALF_SCHEDULE_EVENT_MODEL=haiku
# Contact in the push notification token (required by push services; the default is fine)
PUSH_CONTACT=

# Memory path (relative to the repo root or absolute)
MEMORY_PATH=memory

# Skills folder (default: skills/ at the repo root)
# GANDALF_SKILLS_DIR=

BRIDGE_HOST=127.0.0.1
BRIDGE_PORT=8787
# A simple token for the HUD. Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
BRIDGE_TOKEN=
